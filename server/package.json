{
  "name": "pastio-server",
  "version": "1.0.0",
  "description": "Minimal Socket.IO server for Past.io Party",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "pnpm run build:activity && node server.js",
    "build:activity": "esbuild activity-entry.js --bundle --format=esm --target=es2020 --outfile=../docs/discord-activity.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
